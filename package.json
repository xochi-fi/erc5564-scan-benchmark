{
  "name": "erc5564-scan-benchmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "bench": "bun run src/scan-cost/cli.ts",
    "profile": "bun run src/scan-cost/profile.ts",
    "check": "tsc --noEmit",
    "test": "bun test",
    "paged-discovery": "bun run src/paged-discovery/sweep.ts",
    "paged-discovery:host": "scripts/paged-discovery.sh",
    "paged-discovery:mainnet": "bun run src/paged-discovery/mainnet.ts",
    "chain-volume": "bun run src/chain-volume/run.ts",
    "chain-volume:refresh": "bun run src/chain-volume/refresh.ts",
    "browser-discovery": "bun run src/browser-discovery/run.ts",
    "browser-discovery:serve": "bun run src/browser-discovery/serve.ts",
    "browser-discovery:preflight": "bun run src/browser-discovery/preflight.ts",
    "browser-discovery:reference": "bun run src/browser-discovery/reference.ts",
    "rpc-recovery": "bun run src/rpc-recovery/run.ts",
    "rpc-recovery:serve": "bun run src/rpc-recovery/serve.ts",
    "rpc-recovery:verify": "bun run src/rpc-recovery/verify.ts",
    "rpc-recovery:reference": "bun run src/rpc-recovery/reference.ts",
    "shared-feed": "bun run src/shared-feed/run.ts",
    "shared-feed:verify": "bun run src/shared-feed/verify.ts",
    "shared-feed:tune": "bun run src/shared-feed/tune.ts",
    "figures": "bun run src/figures/figures.ts",
    "tables": "bun run src/figures/tables.ts"
  },
  "dependencies": {
    "@noble/secp256k1": "2.3.0",
    "@scopelift/stealth-address-sdk": "1.0.0-beta.5",
    "viem": "2.58.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
